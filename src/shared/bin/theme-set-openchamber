#!/usr/bin/env python3
"""Publish the active smplOS palette through OpenChamber's custom-theme API."""

import hashlib
import http.client
import json
import math
import os
from pathlib import Path
import re
import sys
import tempfile
import tomllib


ROLES = {
    "primary": {"base": "accent"},
    "surface": {
        "background": "background", "foreground": "foreground", "muted": "surface",
        "mutedForeground": "muted", "elevated": "bg_light",
    },
    "interactive": {"border": "bg_lighter"},
    "status": {
        "error": "danger", "warning": "warning", "success": "success", "info": "info",
    },
}
SYNTAX = {
    "comment": "autosuggestion", "keyword": "accent_alt", "string": "cursor",
    "number": "warning", "function": "accent", "variable": "foreground",
    "type": "info_bright", "operator": "cursor",
}


def warn(message):
    print(f"theme-set-openchamber: {message}", file=sys.stderr)


def palette(current):
    name = (current / "theme.name").read_text().strip()
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", name):
        raise ValueError("Active theme name must be a lowercase hyphenated identifier")
    theme = current / "theme"
    with (theme / "colors.toml").open("rb") as source:
        colors = tomllib.load(source)
    colors.setdefault("autosuggestion", colors.get("muted"))
    for key in {key for group in ROLES.values() for key in group.values()} | set(SYNTAX.values()):
        if not isinstance(colors.get(key), str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", colors[key]):
            raise ValueError(f"Missing or invalid opaque theme color: {key}")
    for key in ("app_background_opacity", "popup_opacity"):
        if key not in colors:
            continue
        value = colors[key]
        if isinstance(value, bool) or not re.fullmatch(r"(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)", str(value)):
            raise ValueError(f"{key} must be a finite decimal in [0,1]")
        number = float(value)
        if not math.isfinite(number) or not 0 <= number <= 1:
            raise ValueError(f"{key} must be a finite decimal in [0,1]")
    opacity = float(colors.get("app_background_opacity", colors.get("popup_opacity", 1)))
    if opacity == 0:
        raise ValueError("OpenChamber requires background opacity above zero")
    mapped = {
        group: {role: colors[key] for role, key in roles.items()}
        for group, roles in ROLES.items()
    }
    mapped["syntax"] = {"base": {role: colors[key] for role, key in SYNTAX.items()}}
    return {
        "metadata": {
            "id": f"smplos-{name}", "name": f"smplOS {name.replace('-', ' ').title()}",
            "variant": "light" if (theme / "light.mode").exists() else "dark",
        },
        "colors": mapped,
        "config": {"backgroundOpacity": opacity},
    }


def targets(home):
    override = home / ".config/smplos/openchamber-data-dirs"
    if override.exists():
        paths = [Path(line.strip()) for line in override.read_text().splitlines()
                 if line.strip() and not line.lstrip().startswith("#")]
        if not paths:
            raise ValueError("openchamber-data-dirs contains no targets")
    else:
        paths = [Path(os.environ.get("OPENCHAMBER_DATA_DIR", home / ".config/openchamber"))]
    if any(not path.is_absolute() for path in paths):
        raise ValueError("OpenChamber data directories must be absolute paths")
    if not override.exists() and "OPENCHAMBER_DATA_DIR" not in os.environ and not (paths[0] / "settings.json").exists():
        return []
    return list(dict.fromkeys(paths))


def backup(home, path, content):
    root = home / ".local/state/smplos/openchamber-theme-backups"
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    root.chmod(0o700)
    directory = root / hashlib.sha256(str(path.parent).encode()).hexdigest()[:16]
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    directory.chmod(0o700)
    target = directory / f"{path.name}.{hashlib.sha256(content).hexdigest()}"
    if not target.exists():
        descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "wb") as output:
            output.write(content)
    target.chmod(0o600)
    if target.read_bytes() != content:
        raise OSError(f"Cannot verify configuration backup for {path}")


def control(port, headers, action, input_value=None):
    payload = {"action": action}
    if input_value is not None:
        payload["input"] = input_value
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=15)
    try:
        connection.request("POST", "/api/openchamber/control", json.dumps(payload), headers)
        response = connection.getresponse()
        if not 200 <= response.status < 300:
            raise ValueError(
                f"OpenChamber {action} returned HTTP {response.status}; application is unconfirmed")
        content = response.read(65537)
        if len(content) > 65536:
            raise ValueError(f"OpenChamber {action} response exceeds 64 KiB")
        reply = json.loads(content)
        if not isinstance(reply, dict):
            raise ValueError(f"OpenChamber {action} response must be an object")
        return reply
    finally:
        connection.close()


def window_states(windows):
    if not isinstance(windows, list) or not windows:
        raise ValueError("OpenChamber has no acknowledged theme windows")
    states = {}
    for window in windows:
        if not isinstance(window, dict):
            raise ValueError("OpenChamber window acknowledgment must be an object")
        identity = window.get("connectionId")
        if not isinstance(identity, str) or not identity or identity in states:
            raise ValueError("OpenChamber connection IDs must be nonempty and unique")
        if type(window.get("transparentWindow")) is not bool:
            raise ValueError("OpenChamber native transparency readiness is unknown")
        states[identity] = window
    return states


def capabilities(port, headers, opacity):
    reply = control(port, headers, "theme.capabilities")
    if (type(reply.get("protocolVersion")) is not int or reply["protocolVersion"] != 1
            or reply.get("customThemes") is not True or reply.get("backgroundOpacity") is not True):
        raise ValueError("OpenChamber does not support the required theme protocol")
    bounds = reply.get("opacityRange")
    if (not isinstance(bounds, dict) or type(bounds.get("minExclusive")) not in (int, float)
            or bounds["minExclusive"] != 0 or type(bounds.get("max")) not in (int, float)
            or bounds["max"] != 1):
        raise ValueError("OpenChamber background opacity range is unsupported")
    timeout = reply.get("ackTimeoutMs")
    if type(timeout) is not int or not 0 < timeout <= 10000:
        raise ValueError("OpenChamber acknowledgment timeout is unsupported")
    windows = window_states(reply.get("windows"))
    if opacity < 1 and any(not window["transparentWindow"] for window in windows.values()):
        raise ValueError("OpenChamber requires a native transparent window for this theme; reopen a compatible desktop build")
    return windows


def confirm_application(reply, expected, theme):
    applied = window_states(reply.get("applied"))
    if (set(applied) != set(expected) or type(reply.get("delivered")) is not int
            or reply["delivered"] != len(expected)):
        raise ValueError("OpenChamber window set changed; theme application is unconfirmed")
    for identity, window in applied.items():
        opacity = window.get("backgroundOpacity")
        if (window.get("themeId") != theme["metadata"]["id"]
                or type(opacity) not in (int, float)
                or opacity != theme["config"]["backgroundOpacity"]
                or window["transparentWindow"] != expected[identity]["transparentWindow"]):
            raise ValueError("OpenChamber renderer did not acknowledge the requested theme and alpha")


def publish(home, directory, theme):
    settings_path = directory / "settings.json"
    saved = settings_path.read_bytes()
    settings = json.loads(saved)
    if not isinstance(settings, dict):
        raise ValueError("OpenChamber settings must be a JSON object")
    port = settings.get("desktopLocalPort")
    if type(port) is not int or not 1 <= port <= 65535:
        raise ValueError("OpenChamber desktopLocalPort must be an integer in [1,65535]")
    headers = {"Content-Type": "application/json"}
    if "desktopLocalClientToken" in settings:
        token = settings["desktopLocalClientToken"]
        if not isinstance(token, str) or not token or any(ord(char) < 33 or ord(char) > 126 for char in token):
            raise ValueError("OpenChamber desktopLocalClientToken is invalid")
        headers["Authorization"] = f"Bearer {token}"
    windows = capabilities(port, headers, theme["config"]["backgroundOpacity"])
    backup(home, settings_path, saved)
    theme_id = theme["metadata"]["id"]
    folder = directory / "themes"
    folder.mkdir(parents=True, exist_ok=True)
    target = folder / f"{theme_id}.json"
    content = (json.dumps(theme, separators=(",", ":")) + "\n").encode()
    previous = target.read_bytes() if target.exists() else None
    if previous != content:
        if previous is not None:
            backup(home, target, previous)
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(dir=folder, prefix=f"{theme_id}.", suffix=".tmp", delete=False) as output:
                temporary = Path(output.name)
                output.write(content)
            temporary.replace(target)
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)
    try:
        reply = control(port, headers, "theme.set", {"id": theme_id})
        confirm_application(reply, windows, theme)
    except (OSError, ValueError, http.client.HTTPException) as error:
        raise ValueError(f"Theme application is unconfirmed and may be partial: {error}") from error


def main():
    if len(sys.argv) != 1:
        warn("Usage: theme-set-openchamber (syncs the active smplOS theme)")
        return 1
    home = Path.home()
    try:
        directories = targets(home)
        if not directories:
            return 0
        theme = palette(home / ".config/smplos/current")
    except (OSError, ValueError) as error:
        warn(str(error))
        return 1
    failed = False
    for directory in directories:
        try:
            publish(home, directory, theme)
        except (OSError, ValueError, http.client.HTTPException) as error:
            warn(f"{directory}: {error}")
            failed = True
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())

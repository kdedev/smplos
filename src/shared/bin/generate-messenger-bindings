#!/bin/bash
# smplOS: Generate Hyprland keybindings for messenger apps.
# Reads messengers.conf, checks which are installed, auto-assigns
# SUPER SHIFT + <letter> from each app's name (skipping taken keys).
# Explicit toggle-messenger shortcuts in bindings.conf take precedence.
# Writes messenger-bindings.conf for Hyprland to source.
#
# Run on login (autostart) and whenever messengers.conf changes.

set -euo pipefail

MESSENGERS_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/smplos/messengers.conf"
BINDINGS_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.conf"
OUTPUT_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/messenger-bindings.conf"
PRIMARY_BINDINGS="${XDG_CONFIG_HOME:-$HOME/.config}/smplos/bindings.conf"
[[ ! -f "$PRIMARY_BINDINGS" ]] || BINDINGS_CONF="$PRIMARY_BINDINGS"

# niri output (sourced into niri's binds.kdl by deploy-niri-config).
SMPLOS_PATH="${SMPLOS_PATH:-$HOME/.local/share/smplos}"
NIRI_OUTPUT_KDL="$SMPLOS_PATH/configs/niri/messenger-binds.kdl"

# --- Collect taken SUPER SHIFT keys from main bindings ---
taken_keys=()
declare -A explicit_mods=() explicit_keys=() explicit_commands=()
messenger_pattern='^[[:space:]]*bindd[[:space:]]*=[[:space:]]*([^,]+),[[:space:]]*([^,]+),[^,]*,[[:space:]]*exec[[:space:]]*,[[:space:]]*toggle-messenger[[:space:]]+("[^"]+"|[^[:space:]]+)[[:space:]]*(.*)$'
if [[ -f "$BINDINGS_CONF" ]]; then
  submap=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*submap[[:space:]]*=[[:space:]]*([^[:space:]]+) ]]; then
      submap="${BASH_REMATCH[1]}"
      [[ "$submap" != reset ]] || submap=""
    fi
    [[ -z "$submap" ]] || continue
    if [[ "$line" =~ $messenger_pattern ]]; then
      mods=$(echo "${BASH_REMATCH[1]}" | xargs)
      key=$(echo "${BASH_REMATCH[2]}" | xargs)
      class="${BASH_REMATCH[3]}"
      class="${class#\"}"; class="${class%\"}"
      explicit_mods["${class,,}"]="$mods"
      explicit_keys["${class,,}"]="$key"
      explicit_commands["${class,,}"]="${BASH_REMATCH[4]}"
    fi
    # Match: bind* = ... SUPER SHIFT ... , <KEY>, ...
    # Also match SHIFT SUPER (order doesn't matter in Hyprland)
    if [[ "$line" =~ ^bind[a-z]*[[:space:]]*=[[:space:]]*(SUPER[[:space:]]+SHIFT|SHIFT[[:space:]]+SUPER)[[:space:]]*,[[:space:]]*([^,]+) ]]; then
      key="${BASH_REMATCH[2]}"
      key=$(echo "$key" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')
      taken_keys+=("$key")
    fi
  done < "$BINDINGS_CONF"
fi

is_key_taken() {
  local k="${1^^}"  # uppercase
  [[ ${#taken_keys[@]} -eq 0 ]] && return 1
  for t in "${taken_keys[@]}"; do
    [[ "$t" == "$k" ]] && return 0
  done
  return 1
}

shortcut_label() {
  local mods="$1"
  mods="${mods//SUPER/Super}"; mods="${mods//CTRL/Ctrl}"
  mods="${mods//SHIFT/Shift}"; mods="${mods//ALT/Alt}"
  printf '%s+%s' "${mods// /+}" "$2"
}

# --- Check if an app is launchable ---
is_installed() {
  local class="$1" cmd="$2"
  local bin="${cmd%% *}"  # first word of launch command

  # Native app binary
  command -v "$bin" &>/dev/null && return 0

  # Flatpak
  flatpak list --app 2>/dev/null | grep -qi "$class" && return 0

  # Webapp (.desktop with launch-webapp in Exec=)
  for dir in "$HOME/.local/share/applications" "/usr/local/share/applications" "/usr/share/applications"; do
    for f in "$dir"/*.desktop; do
      [[ -f "$f" ]] || continue
      if grep -q "launch-webapp" "$f" 2>/dev/null; then
        local wm_class
        wm_class=$(grep -oP 'StartupWMClass=\K.*' "$f" 2>/dev/null || true)
        [[ "${wm_class,,}" == "${class,,}" ]] && return 0
      fi
    done
  done

  return 1
}

# --- Pick the best letter from a name ---
pick_letter() {
  local name="$1"
  local upper="${name^^}"

  # Try each letter in the name
  for (( i=0; i<${#upper}; i++ )); do
    local ch="${upper:$i:1}"
    [[ "$ch" =~ [A-Z] ]] || continue
    if ! is_key_taken "$ch"; then
      echo "$ch"
      return 0
    fi
  done

  # Fallback: try all letters A-Z
  for ch in {A..Z}; do
    if ! is_key_taken "$ch"; then
      echo "$ch"
      return 0
    fi
  done

  return 1
}

# --- Main: parse messengers.conf, generate bindings ---
if [[ ! -f "$MESSENGERS_CONF" ]]; then
  # No config → empty output (clear any stale bindings)
  mkdir -p "$(dirname "$OUTPUT_CONF")"
  echo "# No messengers configured" > "$OUTPUT_CONF"
  exit 0
fi

entries=()
while IFS='|' read -r name class cmd || [[ -n "$name" ]]; do
  # Skip comments and blanks
  [[ "$name" =~ ^[[:space:]]*# ]] && continue
  [[ -z "${name// /}" ]] && continue

  name=$(echo "$name" | xargs)    # trim whitespace
  class=$(echo "$class" | xargs)
  cmd=$(echo "$cmd" | xargs)

  # Skip apps that aren't installed
  if ! is_installed "$class" "${explicit_commands[${class,,}]:-$cmd}"; then
    continue
  fi

  if [[ -n "${explicit_keys[${class,,}]:-}" ]]; then
    letter="${explicit_keys[${class,,}]}"
    mods="${explicit_mods[${class,,}]}"
    cmd="${explicit_commands[${class,,}]}"
    explicit=yes
  else
    letter=$(pick_letter "$name") || continue
    taken_keys+=("$letter")
    mods="SUPER SHIFT"
    explicit=no
  fi

  entries+=("${name}|${class}|${cmd}|${letter}|${mods}|${explicit}")
done < "$MESSENGERS_CONF"

# --- Write Hyprland output ---
mkdir -p "$(dirname "$OUTPUT_CONF")"
{
  echo "# Auto-generated by generate-messenger-bindings -- do not edit"
  echo ""
  echo "# MESSENGERS"
  echo ""

  if [[ ${#entries[@]} -gt 0 ]]; then
    for entry in "${entries[@]}"; do
      IFS='|' read -r name class cmd letter mods explicit <<< "$entry"
      [[ "$explicit" != yes ]] || continue
      echo "bindd = ${mods}, ${letter}, ${name}, exec, toggle-messenger \"${class}\" ${cmd}"
    done

    echo ""
    echo "# Assigned keys:"
    for entry in "${entries[@]}"; do
      IFS='|' read -r name class cmd letter mods explicit <<< "$entry"
      origin=""
      [[ "$explicit" != yes ]] || origin=" (bindings.conf)"
      echo "#   $(shortcut_label "$mods" "$letter") → ${name}${origin}"
    done
  fi
} > "$OUTPUT_CONF"

# --- Write niri output (always, even if empty) ---
# Niri's binds.kdl has no `include` directive, so deploy-niri-config
# concatenates this partial in. Whenever this file changes we redeploy + reload.
mkdir -p "$(dirname "$NIRI_OUTPUT_KDL")"
{
  echo "// Auto-generated by generate-messenger-bindings -- do not edit"
  echo "// Concatenated into binds.kdl by deploy-niri-config."
  echo ""
  for entry in "${entries[@]}"; do
    IFS='|' read -r name class cmd letter mods explicit <<< "$entry"
    # KDL-escape backslash and double-quote inside the command + class.
    cmd_esc="${cmd//\\/\\\\}"; cmd_esc="${cmd_esc//\"/\\\"}"
    cls_esc="${class//\\/\\\\}"; cls_esc="${cls_esc//\"/\\\"}"
    nme_esc="${name//\\/\\\\}"; nme_esc="${nme_esc//\"/\\\"}"
    if [[ "$explicit" == yes ]] &&
        grep -Fq "hotkey-overlay-title=\"${nme_esc}\"" "$(dirname "$NIRI_OUTPUT_KDL")/binds.kdl" 2>/dev/null; then
      continue
    fi
    niri_mods=""
    for modifier in $mods; do
      case "$modifier" in
        SUPER) niri_mods+="Mod+" ;;
        CTRL) niri_mods+="Ctrl+" ;;
        SHIFT) niri_mods+="Shift+" ;;
        ALT) niri_mods+="Alt+" ;;
        *) echo "Unsupported messenger modifier: $modifier" >&2; exit 1 ;;
      esac
    done
    echo "    ${niri_mods}${letter^} hotkey-overlay-title=\"${nme_esc}\" { spawn \"sh\" \"-c\" \"toggle-messenger \\\"${cls_esc}\\\" ${cmd_esc}\"; }"
  done
} > "$NIRI_OUTPUT_KDL"

# If running under niri, redeploy + reload so new binds take effect immediately.
if [[ -n "${NIRI_SOCKET:-}" ]] && command -v deploy-niri-config >/dev/null 2>&1; then
  deploy-niri-config 2>/dev/null || true
fi

# Notify the user of assigned keys (on first run or changes)
if [[ ${#entries[@]} -gt 0 ]]; then
  summary=""
  for entry in "${entries[@]}"; do
    IFS='|' read -r name class cmd letter mods explicit <<< "$entry"
    summary+="$(shortcut_label "$mods" "$letter")  ${name}\n"
  done
  # Only notify if running interactively (not during boot)
  if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v notify-send &>/dev/null; then
    notify-send -a "smplOS" "Messenger Shortcuts" "$(printf "$summary")" 2>/dev/null || true
  fi
fi

echo "Configured ${#entries[@]} messenger shortcut(s) → $OUTPUT_CONF"

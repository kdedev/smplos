#!/bin/bash
# smplOS: Apply theme colors to all running st/st-wl terminals via OSC escape sequences
# Called by theme-set after copying theme files into place.
#
# Uses OSC 4 (palette 0-15), OSC 10 (fg), OSC 11 (bg), OSC 12 (cursor)
# These are standard VT escape sequences -- work on both X11 and Wayland, no dependencies.

CURRENT_THEME_PATH="$HOME/.config/smplos/current/theme"
COLORS_FILE="$CURRENT_THEME_PATH/colors.toml"

[[ -f "$COLORS_FILE" ]] || exit 0

# Parse a color value from colors.toml
get_color() {
  sed -n "s/^${1}[[:space:]]*=[[:space:]]*[\"']\(.*\)[\"']/\1/p" "$COLORS_FILE" | head -1
}

# Build the full OSC sequence payload (all colors in one string for efficiency)
osc=""

append_osc() {
  osc+=$'\033]'"$1"$'\033\\'
}

# OSC 4: set palette colors 0-15
for i in $(seq 0 15); do
  color=$(get_color "color${i}")
  [[ -n "$color" ]] && append_osc "4;${i};${color}"
done

# OSC 10: foreground
fg=$(get_color "foreground")
[[ -n "$fg" ]] && append_osc "10;${fg}"

# OSC 11: background
bg=$(get_color "background")
[[ -n "$bg" ]] && append_osc "11;${bg}"

# OSC 12: cursor color
cursor=$(get_color "cursor")
[[ -n "$cursor" ]] && append_osc "12;${cursor}"

[[ -z "$osc" ]] && exit 0

# The terminal's stdin belongs to its launcher (often /dev/tty2), not its
# child shell. Linux exposes the slave's index on the PTY master's fdinfo.
status=0
while read -r pid; do
  comm=$(cat "/proc/$pid/comm" 2>/dev/null) || continue
  pty_index=$(awk '$1 == "tty-index:" { print $2; exit }' "/proc/$pid"/fdinfo/* 2>/dev/null)
  if [[ ! "$pty_index" =~ ^[0-9]+$ ]]; then
    [[ -d "/proc/$pid" ]] || continue
    echo "theme-set-st: Cannot find PTY for $comm ($pid)" >&2
    status=1
    continue
  fi
  pty="/dev/pts/$pty_index"

  # Write OSC sequences to the pty (palette + fg/bg/cursor colors)
  # A Ctrl-S/flow-stopped PTY can block writes indefinitely. Open it inside the
  # timed child as well, so a paused terminal cannot stall the whole switch.
  if ! timeout --kill-after=1s 1s bash -c 'printf "%s" "$1" > "$2"' _ "$osc" "$pty"; then
    echo "theme-set-st: Cannot update $pty for $comm ($pid)" >&2
    status=1
    continue
  fi

  # Signal st-wl to reload theme alpha from colors.toml immediately.
  # Do not signal X11 st: its default SIGUSR1 handler terminates the process.
  [[ "$comm" == "st-wl" ]] && kill -USR1 "$pid" 2>/dev/null || true
done < <(pgrep -u "$UID" -x 'st|st-wl')
exit "$status"

#!/bin/bash
# smplos-reboot-notify — Show a reboot-required notification after an update
#
# Called from two places:
#   1. smplos-update at the end of a run that applied a critical bundle
#   2. Hyprland autostart on every login (to re-notify if reboot is still pending)
#
# Marker: ~/.local/state/smplos/reboot-pending
# Format: single line containing the boot_id that was current when the update ran.
# Clicking the reminder opens a second, explicit restart confirmation.

die() {
    echo "smplos-reboot-notify: $*" >&2
    logger -t smplos-reboot-notify -- "$*"
    if command -v notify-send &>/dev/null; then
        notify-send -u critical -i dialog-warning "Restart not started" "$*"
    fi
    exit 1
}
SELF="$(readlink -f "$0")"
helper=""
for candidate in "${SELF%/*}/../lib/smplos/smplos-reboot.sh" \
    "${SELF%/*}/../lib/smplos-reboot.sh" \
    "${SMPLOS_PATH:-$HOME/.local/share/smplos}/repo/src/shared/lib/smplos-reboot.sh"; do
    [[ -r "$candidate" ]] || continue
    helper="$candidate"
    break
done
[[ -n "$helper" ]] || die "pending-reboot helper is missing"
source "$helper" || die "cannot load the pending-reboot helper"
MARKER="$HOME/.local/state/smplos/reboot-pending"
# Older smplos-update releases wrote it one directory deeper.
[[ -f "$MARKER" ]] || MARKER="$HOME/.local/state/smplos/update/reboot-pending"

# ── Check if a reboot is actually pending ────────────────────────────────────
pending=0
smplos_reboot_pending "$MARKER" || pending=$?
if [[ $pending -ne 0 ]]; then
    [[ $pending -eq 1 ]] || die "cannot verify the pending reboot"
    rm -f -- "$MARKER" || die "cannot clear the expired reboot marker"
    exit 0
fi

notify_action() {
    if command -v dunstify &>/dev/null && pgrep -x dunst &>/dev/null; then
        dunstify -t 0 -u critical -i system-reboot \
            -h string:x-dunst-stack-tag:smplos-reboot \
            -A "default,$1" -A "cancel,Cancel" "$2" "$3"
    elif command -v notify-send &>/dev/null; then
        notify-send --wait -t 0 -u critical -i system-reboot \
            --action="default=$1" --action="cancel=Cancel" "$2" "$3"
    else
        die "no notification client is available"
    fi
}

action=$(notify_action "Review restart" "smplOS: Reboot required" \
    "Restart to use the updated system. Click this message to review restarting.") ||
    die "cannot show the reboot reminder"
[[ "$action" == default ]] || exit 0
action=$(notify_action "Restart now" "Restart smplOS now?" \
    "Save your work first. Click this confirmation to restart now. Dismiss or right-click to cancel.") ||
    die "cannot show the restart confirmation"
[[ "$action" == default ]] || exit 0
mkdir -p "$HOME/.local/state/smplos/update" || die "cannot inspect the update lock"
exec 9>>"$HOME/.local/state/smplos/update/update.lock" || die "cannot open the update lock"
if ! flock -n 9; then
    exec 9>&-
    die "A system update is running. Wait for it to finish before restarting."
fi
trap 'flock -u 9; exec 9>&-' EXIT
systemctl reboot || die "restart was refused; save your work and try again from the power menu"

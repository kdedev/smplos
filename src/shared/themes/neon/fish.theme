# smplOS Fish Theme Colors
# Auto-generated by theme system -- do not edit manually

# Syntax highlighting
set -g fish_color_normal d6f5ff
set -g fish_color_command 00f0ff
set -g fish_color_keyword 3f8cff
set -g fish_color_quote 2dffb2
set -g fish_color_redirection 8fe8ff
set -g fish_color_end 3f8cff
set -g fish_color_error ff4d6d
set -g fish_color_param d6f5ff

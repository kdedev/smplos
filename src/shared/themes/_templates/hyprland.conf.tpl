# smplOS Hyprland Theme — auto-generated from colors.toml
$activeBorderColor = {{ border_active }}
$inactiveBorderColor = {{ border_inactive }}

# Decoration overrides (theme-controlled)
$themeRounding = {{ rounding }}
$themeRoundingPower = {{ rounding_power }}
$themeGapsIn = {{ gaps_in }}
$themeGapsOut = {{ gaps_out }}
$themeBorderSize = {{ hypr_border_size }}
$themeBlurSize = {{ blur_size }}
$themeBlurPasses = {{ blur_passes }}
$themeOpacityActive = {{ opacity_active }}
$themeOpacityInactive = {{ opacity_inactive }}
$themePopupOpacity = {{ popup_opacity }}
$themeMessengerOpacity = {{ messenger_opacity }}
$themeBrowserOpacity = {{ browser_opacity }}

# Window effects (optional; defaults = classic subtle shadow, no glow, static border)
$themeShadowRange = {{ shadow_range }}
$themeShadowRenderPower = {{ shadow_render_power }}
$themeShadowColor = {{ shadow_color }}
$themeShadowColorInactive = {{ shadow_color_inactive }}
$themeGlow = {{ glow_flag }}
$themeGlowRange = {{ glow_range }}
$themeGlowRenderPower = {{ glow_render_power }}
$themeGlowColor = {{ glow_color }}
$themeGlowColorInactive = {{ glow_color_inactive }}
$themeBorderAnimation = {{ border_animation_flag }}

# HUD frames (read by the smpl-hud Hyprland plugin; Hyprland ignores these)
$themeHudFrame = {{ hud_frame_flag }}
$themeHudStyle = {{ hud_style }}
$themeHudGap = {{ hud_gap }}
$themeHudChamfer = {{ hud_chamfer }}
$themeHudLineWidth = {{ hud_line_width }}
$themeHudFloatGlowRange = {{ hud_float_glow_range }}
$themeHudSweep = {{ hud_sweep_flag }}
$themeHudSweepSpeed = {{ hud_sweep_speed }}
$themeHudSweepLength = {{ hud_sweep_length }}
$themeHudHideBorder = {{ hud_hide_border_flag }}
$themeHudGlyphColor = {{ hud_glyph_color }}
$themeHudSideOpacity = {{ hud_side_opacity }}
$themeHudEdgeOpacity = {{ hud_edge_opacity }}
$themeHudUnderglow = {{ hud_underglow }}
$themeHudScanner = {{ hud_scanner }}

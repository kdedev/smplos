+use super::*;
+use crate::{client, daemon_response::DaemonResponse};
+use std::{io::Read, os::unix::net::UnixStream, thread, time::Instant};
+
+fn exchange(delay: Duration, reply: Option<bool>) -> DaemonResponse {
+    tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap().block_on(async {
+        let (mut client_socket, server_socket) = UnixStream::pair().unwrap();
+        server_socket.set_nonblocking(true).unwrap();
+        let server_socket = tokio::net::UnixStream::from_std(server_socket).unwrap();
+        let (sender, mut receiver) = unbounded_channel();
+        let client = thread::spawn(move || {
+            client::do_server_call(&mut client_socket, &opts::ActionWithServer::Reload).unwrap().unwrap()
+        });
+        let server = tokio::spawn(handle_connection(server_socket, sender));
+        let application = tokio::spawn(async move {
+            let command = receiver.recv().await.unwrap();
+            let app::DaemonCommand::ReloadConfigAndCss(sender) = command else { panic!("wrong command") };
+            tokio::time::sleep(delay).await;
+            match reply {
+                Some(true) => sender.send_success("reloaded".into()).unwrap(),
+                Some(false) => sender.send_failure("invalid SCSS".into()).unwrap(),
+                None => drop(sender),
+            }
+        });
+        server.await.unwrap().unwrap();
+        application.abort();
+        client.join().unwrap()
+    })
+}
+
+#[test]
+fn slow_success_is_acknowledged() {
+    assert_eq!(exchange(Duration::from_millis(300), Some(true)), DaemonResponse::Success("reloaded".into()));
+}
+
+#[test]
+fn slow_failure_is_not_reported_as_success() {
+    assert_eq!(exchange(Duration::from_millis(300), Some(false)), DaemonResponse::Failure("invalid SCSS".into()));
+}
+
+#[test]
+fn dropped_application_reply_is_failure() {
+    assert_eq!(exchange(Duration::ZERO, None), DaemonResponse::Failure("Eww command ended without a response".into()));
+}
+
+#[test]
+fn server_deadline_is_bounded_and_explicit() {
+    let start = Instant::now();
+    assert_eq!(exchange(Duration::from_secs(30), None),
+               DaemonResponse::Failure("Eww command did not complete within 10 seconds".into()));
+    assert!(start.elapsed() >= Duration::from_secs(10));
+    assert!(start.elapsed() < Duration::from_secs(15));
+}
+
+fn empty_reply(action: opts::ActionWithServer) -> Result<Option<DaemonResponse>> {
+    let (mut client_socket, mut server_socket) = UnixStream::pair().unwrap();
+    let server = thread::spawn(move || {
+        let mut header = [0; 4];
+        server_socket.read_exact(&mut header).unwrap();
+        let mut body = vec![0; u32::from_be_bytes(header) as usize];
+        server_socket.read_exact(&mut body).unwrap();
+    });
+    let result = client::do_server_call(&mut client_socket, &action);
+    server.join().unwrap();
+    result
+}
+
+#[test]
+fn missing_required_reply_is_not_success() {
+    let error = empty_reply(opts::ActionWithServer::Reload).unwrap_err();
+    assert!(error.to_string().contains("without a required response"));
+}
+
+#[test]
+fn fire_and_forget_still_accepts_empty_reply() {
+    assert!(empty_reply(opts::ActionWithServer::KillServer).unwrap().is_none());
+}

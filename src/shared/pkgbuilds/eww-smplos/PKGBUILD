# Maintainer: smplOS <https://github.com/smpl-os>
# smplOS build of eww with the button-click grab fixes.
#
# Upstream eww hasn't cut a release since v0.6.0 (April 2024) despite
# ~30+ fixes on master, and the smplOS fork adds two Wayland fixes on
# top that are required for the smplOS bar to be usable:
#
#   78105f3  fix: Propagation::Stop on button_press prevents GTK default
#            grab handler
#   169e47a  fix: avoid pointer grab stuck on button press (Wayland)
#   0eb4604  defwindow :passthrough (empty input region; the keypad's
#            click-through cheatsheet, KEYPAD.md). Verified on X11 only;
#            Wayland pending.
#
# Without these two commits, clicking a button on the eww bar frequently
# no-ops until the user moves the mouse — because GTK's default button-
# press handler installs an implicit pointer grab that Wayland never sees
# released. Every customer machine running vanilla AUR `eww` (built from
# upstream tag v0.6.0) has this bug.
#
# The fork's master branch is rebased on top of upstream master so we
# also pick up ~30 fixes and features that upstream never released
# (formattime crash fix, NaN graph crash fix, systray fixes, wayland
# multi-monitor improvements, `unfocus-close` on defwindow, etc.).
#
# We pin to a specific fork commit rather than tracking HEAD so the fleet
# stays deterministic — bump _commit + pkgrel here and write a migration
# to redeploy.
#
# Checked 2026-10-18: upstream master 48f5aa8 lacks all three fork changes.
# https://github.com/elkowar/eww/pull/1428 is open and covers only 169e47a,
# not 78105f3. https://github.com/elkowar/eww/pull/1437 is open and Wayland-only,
# not an equivalent replacement for the fork's X11/Wayland passthrough.

_gh_owner=smpl-os
_gh_repo=eww
_commit=0eb460422278dfaec64e5a527c1fd35dd3b35a1b

pkgname=eww-smplos
pkgver=0.6.0.r721.g0eb4604
pkgrel=5
pkgdesc='Standalone widget system made in Rust (smplOS fork with Wayland button-grab fixes)'
arch=(x86_64)
url="https://github.com/${_gh_owner}/${_gh_repo}"
license=(MIT)
makedepends=(cargo git)
depends=(libdbusmenu-gtk3 gtk3 gtk-layer-shell)
provides=(eww)
conflicts=(eww)
replaces=(eww)
options=(!debug)

source=("git+${url}.git#commit=${_commit}" 'ipc-repair.patch')
sha256sums=('SKIP' 'eb30b0a1c2dc7bf8b44a52d1f5f39cdbecbdaa67c9c6737deb7370d00555c538')

pkgver() {
    cd "$srcdir/$_gh_repo"
    local base
    base=$(awk -F '"' '/^version/ {print $2; exit}' crates/eww/Cargo.toml 2>/dev/null || echo 0.6.0)
    printf '%s.r%s.g%s\n' "$base" \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$srcdir/$_gh_repo"
    patch -Np1 -i "$srcdir/ipc-repair.patch" || return 1
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "$srcdir/$_gh_repo"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$srcdir/$_gh_repo"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release -p eww ipc_repair -- --test-threads=1
}

package() {
    cd "$srcdir/$_gh_repo"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
    install -d "$pkgdir/etc/xdg/eww/"
    cp -r examples/eww-bar "$pkgdir/etc/xdg/eww/"
    install -Dm755 target/release/eww -t "$pkgdir/usr/bin/"
}
